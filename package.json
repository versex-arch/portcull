{
  "name": "portcull",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, browser-based cyber attack & defense simulator.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
